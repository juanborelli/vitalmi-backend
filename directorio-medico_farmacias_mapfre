$('.modal-triger').off('click').on('click', function(e){
    e.preventDefault();
    modalLoading(true);
    var thisModal = $($(this).data('bs-target'));
    var thisPath = $(this).data('detailpath');
    var thisPlanes = $(this).data('planes');
    var thisLatLong = $(this).data('latlong');

    $.ajax({
        url: '/providerInfo/'+thisPath,
        method: "GET",
        dataType: 'json',
        async: true,
        timeout: 10000,
        success: function (response) {
            var phones = '';
            if(response.phoneNumbers && response.phoneNumbers.length) {
                phones = '<h4>Teléfono(s)</h4><ul class="phoneList">';
                for(x in response.phoneNumbers){
                    lab = response.phoneNumbers[x].label;
                    val = response.phoneNumbers[x].value;
                    phones += '<li>'+lab+': <a href="tel:'+val+'">'+val+'</a></li>';
                }
                phones += '</ul>';
            }


            var plans = '';
            var plan_list = thisPlanes;
            try { if(response.planType.length) plan_list = response.planType; } catch(e) {}

            if(plan_list) {
                plans = '<h4>Planes aceptados</h4><ul>';
                for(x in plan_list){
                    lab = plan_list[x].name;
                    plans += "<li>"+lab+"</li>";
                }
                plans += '</ul>';
            }

            var address = '';

            var d,
                lines = [],
                sector = [],
                full_address = '';
            if(d=response.location) lines.push(d);
            if(d=response.address) lines.push(d);
            if(d=response.sector) sector.push(d);
            if(d=response.city) sector.push(d);
            if(d=sector.join(', ')) lines.push(d);
            full_address = lines.join('<br>');

            if(full_address)
                address = '<h4>Dirección</h4><p>'+full_address+'</p>';

            var map = '';
            var thisMap = {latitude:thisLatLong[0], longitude:thisLatLong[1]};

            if(thisMap.latitude && thisMap.longitude) {
                map += '<div class="mapa">\
                        <iframe src="https://www.google.com/maps?q='+thisMap.latitude+','+thisMap.longitude+'&z=16&output=embed" width="100%" height="300" frameborder="0" style="border:0;margin-bottom:-1ex;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>\
                        </div>';
            }

            var output='<div class="col-md-6 col-sm-12">\
                '+phones+' '+plans+'</div>\
                <div class="col-md-6 col-sm-12">\
                '+address+' '+map+'</div>';

            $(thisModal)
                .find('.modal-body .row')
                .html(output);


            var _type = '';
            var _specialties = [];

            try { specialties.push(response.type.name); } catch(e){}
            try { _specialties = _specialties.concat(response.specialty); } catch(e){}

            $(thisModal)
                .find('.modal-header .specialtyList')
                .empty()
                .append(_type)
                .append(
                    _specialties.length
                    ? ' - ' + _specialties
                        .map(function(e){return e.name;})
                        .reduce(function(a,c){return a+', '+c;})
                    : '' );


            modalLoading(false);
            $(thisModal).modal();
        }
    })
    .fail(function (err) {
        modalLoading(false);
    })
});


</script>
